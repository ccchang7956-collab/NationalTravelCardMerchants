# 國旅卡特約商店查詢系統 — 環境變數設定
# 複製此檔為 .env 並依需求修改
# cp .env.example .env

# ── 前端 ────────────────────────────────────────────────────────────────────
# 客戶端瀏覽器連線到 backend API 的公開地址
# 本地開發：http://localhost:8000
# 生產環境：https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── 後端 ────────────────────────────────────────────────────────────────────
# 允許跨來源的前端網址（逗號分隔多個）
CORS_ORIGINS=http://localhost:3000

# ── Port 設定（選填，預設如下）────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
