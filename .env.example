# 國旅卡特約商店查詢系統 — 環境變數設定
# 複製此檔為 .env 並依需求修改
# cp .env.example .env
# 生產部署用 ./deploy.sh（切勿直接 docker compose up，也不要套用 docker-compose.dev.yml）

# ── 前端 ────────────────────────────────────────────────────────────────────
# 客戶端瀏覽器連線到 backend API 的公開地址
# 本專案靠 nginx 同域分流（/ → frontend，/api/ → backend），前後端同網域即可：
# 本地開發：http://localhost:8000
# 生產環境：https://ntc.shibaalin.com（與 SITE_URL 同值，不要拆 api 子域）
NEXT_PUBLIC_API_URL=http://localhost:8000

# 網站正式上線網址（用於 SEO metadata、sitemap.xml、Open Graph）
# 本地開發：http://localhost:3000
# 生產環境：https://ntc.shibaalin.com
# 注意：NEXT_PUBLIC_* 為 build-time inline，改網域必須重 build 前端映像；
# 且 production 下未設定此值會 throw（見 frontend/src/utils/site.ts getSiteUrl）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 後端 ────────────────────────────────────────────────────────────────────
# 允許跨來源的前端網址（逗號分隔多個）
CORS_ORIGINS=http://localhost:3000

# JWT 簽發密鑰（已退役：後端現為純公開站，無任何 JWT 邏輯，此值可留空）
# 若未來重啟登入功能再填：openssl rand -hex 32
JWT_SECRET_KEY=

# 資料新鮮度告警門檻（小時）：/api/health 的 last_updated 超過此值視為 stale，預設 48
# DATA_STALE_AFTER_HOURS=48

# ── 排程 ────────────────────────────────────────────────────────────────────
# 更新失敗通知（Slack/Discord webhook，空字串=僅寫 log；建議生產設一個，否則停更無人知）
# NOTIFY_WEBHOOK_URL=

# 大量刪除安全閘門：舊庫超過 MASS_DELETE_MIN_OLD 筆且新筆數低於 MASS_DELETE_RATIO 比例時中止同步
# MASS_DELETE_MIN_OLD=100
# MASS_DELETE_RATIO=0.5

# ── 內網（免設，compose 已內定）────────────────────────────────────────────
# 前端 SSR 用內網直連後端，不經 tunnel：INTERNAL_API_URL=http://backend:8000（compose 寫死）

# ── Port 設定（選填，預設如下）────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
