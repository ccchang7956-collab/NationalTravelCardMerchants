# 國旅卡特約商店查詢系統 — 環境變數設定
# 複製此檔為 .env 並依需求修改
# cp .env.example .env

# ── 前端 ────────────────────────────────────────────────────────────────────
# 客戶端瀏覽器連線到 backend API 的公開地址
# 本地開發：http://localhost:8000
# 生產環境：https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 網站正式上線網址（用於 SEO metadata、sitemap.xml、Open Graph）
# 本地開發：http://localhost:3000
# 生產環境：https://ntc.example.tw
# 注意：NEXT_PUBLIC_* 為 build-time inline，改網域必須重 build 前端映像；
# 且 production 下未設定此值會 throw（見 frontend/src/utils/site.ts getSiteUrl）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 後端 ────────────────────────────────────────────────────────────────────
# 允許跨來源的前端網址（逗號分隔多個）
CORS_ORIGINS=http://localhost:3000

# JWT 簽發密鑰（production 必填，否則 backend 啟動時 fail-fast 拋 RuntimeError）
# 產生方式：openssl rand -hex 32
# 本地開發可用任意隨機字串；正式環境務必使用強隨機值並妥善保管，切勿提交到版控。
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Port 設定（選填，預設如下）────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
